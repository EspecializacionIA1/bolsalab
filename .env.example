# Copiar a .env y completar. El archivo .env no se sube a git.

# SEC EDGAR exige identificarse con nombre y correo en cada petición.
SEC_USER_AGENT="BolsaLAB research tu_correo@javeriana.edu.co"

# MLflow del equipo. Sin estas líneas se usa mlflow.db en el proyecto.
# MLFLOW_TRACKING_URI=https://mlflow.bolsa-lab.site
# MLFLOW_TRACKING_USERNAME=bolsalab
# MLFLOW_TRACKING_PASSWORD=

# Llave gratuita de FRED (https://fred.stlouisfed.org/docs/api/api_key.html). Opcional en desarrollo.
FRED_API_KEY=
