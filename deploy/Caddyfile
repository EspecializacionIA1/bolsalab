# Caddy recibe todo el tráfico, saca los certificados HTTPS y reparte.

{$DOMAIN} {
	encode gzip

	# La API. Caddy le pasa la IP real del usuario (X-Forwarded-For) para el límite por IP.
	handle /api/* {
		# El cuestionario pesa menos de 1 KB; nada más grande pasa.
		request_body {
			max_size 10KB
		}
		reverse_proxy api:8000
	}

	# Todo lo demás: la página del sitio.
	handle {
		root * /srv/site
		file_server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# MLflow solo con usuario y contraseña. El hash viene de Parameter Store.
mlflow.{$DOMAIN} {
	basic_auth {
		{$MLFLOW_USER} {$MLFLOW_PASSWORD_HASH}
	}
	reverse_proxy mlflow:5000
}
